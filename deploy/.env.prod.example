# Production values for the VPS deployment (deploy/README.md). Copy to
# .env in the repo root on the VPS and fill in the blanks -- do not commit
# the filled-in file, it is git-ignored same as the local .env.

# --- Postgres -------------------------------------------------------------
# Change these from the docker-compose.yml defaults for anything internet-
# reachable.
POSTGRES_USER=toleman
POSTGRES_PASSWORD=
POSTGRES_DB=toleman

# --- Backend / Celery worker ------------------------------------------------
# Random shared secret for the scan-results ingest API.
WORKSPACE_API_KEY=

# HMAC key signing the session cookie.
SESSION_SECRET=

# Now served over HTTPS (via Caddy), so this must be True -- False here
# would make the browser silently drop the session cookie.
COOKIE_SECURE=True

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional: enables AI-assisted finding analysis. Leave blank to disable.
ANTHROPIC_API_KEY=

# Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_ENCRYPTION_KEY=

# --- Public addresses -------------------------------------------------------
PUBLIC_BASE_URL=https://toleman.oasisgoods.store
PUBLIC_API_URL=https://api.toleman.oasisgoods.store
EXTRA_CORS_ORIGINS=

# --- Frontend ---------------------------------------------------------------
# Build-time fallback only; app/layout.tsx injects PUBLIC_API_URL above at
# runtime, so this rarely matters, but keep it consistent.
NEXT_PUBLIC_API_URL=https://api.toleman.oasisgoods.store
