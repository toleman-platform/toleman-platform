# Hardened runtime stage on gcr.io/distroless/cc-debian12 -- no shell, no
# package manager, minimal attack surface. Everything is built normally in a
# python:3.12-slim `builder` stage (identical to the original single-stage
# Dockerfile), then only the specific files runtime needs are copied into
# the distroless final stage.
#
# Verified (#158): a real HTTPS git clone + a real `semgrep --config auto`
# scan both run successfully inside the built image (not just "docker build
# succeeds"). Trivy self-scan, CRITICAL+HIGH only: 135 -> 75 vulnerabilities
# vs. the original image, entirely from dropping the Debian OS-package layer
# (60 CVEs) -- the remaining 75 are in Python itself and the Gitleaks/gosec/
# Trivy binaries' own bundled dependency versions, unrelated to base-image
# choice. Image size 1.22GB -> 1.04GB. NOT yet wired into docker-compose.yml
# or CI as the default -- available as an alternative, promote deliberately.
#
# Why distroless/cc-debian12 and not Chainguard: Chainguard's free tier only
# ships a rolling `latest` tag (Python 3.14 as of this writing), and this
# project is pinned to 3.12 exactly (3.14 breaks pydantic-core/psycopg wheel
# builds -- see the original Dockerfile). Pinned Chainguard versions require
# a paid Console subscription. distroless/cc-debian12 was chosen over the
# plainer distroless/base-debian12 because it already bundles libstdc++/
# libgcc_s (needed by a couple of Pillow/greenlet .so's) alongside glibc,
# openssl, and ca-certificates -- one dependency fewer to hand-vendor.
#
# The remaining gap, and it's bigger than it first looked: the bare `git`
# binary itself only needs pcre2/z/c, but `clone_repo()` clones over https,
# which git always shells out to a separate helper for --
# /usr/lib/git-core/git-remote-https. THAT binary links the full libcurl-
# gnutls stack (TLS, HTTP/2, SSH, RTMP, brotli, punycode/IDN, GSSAPI/LDAP/
# SASL for optional auth schemes this project doesn't use) -- 28 extra
# shared libraries distroless doesn't ship, not the ~13 an initial pass over
# the plain `git` binary suggested. Gitleaks/Trivy/gosec/semgrep-core are
# still all static binaries -- zero extra shared-library dependencies,
# confirmed via `ldd` (see #158).
#
# MUST be pinned to -bookworm (Debian 12), not the floating `python:3.12-slim`
# tag -- that now resolves to Debian 13 "trixie" (glibc 2.41), while
# distroless/cc-debian12 is glibc ~2.36. A binary/interpreter built against
# the newer glibc fails at runtime in the older one with
# `version 'GLIBC_2.38' not found` -- caught live in this exact spike.
# distroless has no debian13 variant yet, so the builder pins down to match
# the runtime, not the other way around.
FROM python:3.12-slim-bookworm AS builder

ARG GITLEAKS_VERSION=8.21.2
ARG TRIVY_VERSION=0.73.0
ARG GOSEC_VERSION=2.28.0

# (BLD-04) Checksums of the *installer scripts* fetched below, at the tags
# pinned above -- independently re-derived, not copied. Pinning the tool
# version never covered these: the scripts came from a mutable branch tip.
ARG TRIVY_INSTALLER_SHA256=e00df553be558995b994758bc8995956554a16937f456dc6615b0cc411bfec7a
ARG GOSEC_INSTALLER_SHA256=2aafc038c170fb6141727d247ad5a17ded5bf195ad0fb8ed1b8e0aed326ac78f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        tar \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) GITLEAKS_ARCH=x64 ;; \
        arm64) GITLEAKS_ARCH=arm64 ;; \
        *) echo "unsupported arch: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" \
        | tar xz -C /usr/local/bin gitleaks; \
    gitleaks version

# (BLD-04, second half) These two fetched their installer from the tip of a
# mutable default branch and piped it straight into `sh`. backend/Dockerfile
# was fixed in #234; this file was missed, so the *hardened* image was the
# less safe of the two on exactly the axis this product sells. A security
# tool whose own build trusts a moving URL is the first thing a reviewer
# points at.
#
# Same treatment as the standard image: fetch the script from the same tag as
# the version being installed, and verify its checksum before running it. The
# tag pin removes the moving target; the checksum makes a force-pushed or
# retagged script fail the build loudly instead of executing silently.
#
# To bump: change the ARG, re-fetch, and record the new sum with
#   curl -sSL <url> | sha256sum
RUN curl -sSL -o /tmp/trivy-install.sh \
        "https://raw.githubusercontent.com/aquasecurity/trivy/v${TRIVY_VERSION}/contrib/install.sh" \
    && echo "${TRIVY_INSTALLER_SHA256}  /tmp/trivy-install.sh" | sha256sum -c - \
    && sh /tmp/trivy-install.sh -b /usr/local/bin "v${TRIVY_VERSION}" \
    && rm -f /tmp/trivy-install.sh \
    && trivy --version

# gosec's installer resolves the release through GitHub's API, which is rate
# limited for unauthenticated callers. When that limit is hit it reports
# "unable to find 'vX.Y.Z'" -- indistinguishable from a genuinely missing
# tag, and the reason this build failed confusingly during the CI migration
# while v2.28.0 was in fact the latest release. Nothing here can raise the
# limit, but pinning the script at least removes one moving part from the
# diagnosis.
RUN curl -sSL -o /tmp/gosec-install.sh \
        "https://raw.githubusercontent.com/securego/gosec/v${GOSEC_VERSION}/install.sh" \
    && echo "${GOSEC_INSTALLER_SHA256}  /tmp/gosec-install.sh" | sha256sum -c - \
    && sh /tmp/gosec-install.sh -b /usr/local/bin "v${GOSEC_VERSION}" \
    && rm -f /tmp/gosec-install.sh \
    && gosec --version

#
# `setuptools<81` is load-bearing, not hygiene. Nothing here asks for
# setuptools directly -- semgrep's pinned opentelemetry-instrumentation
# (0.46b0) declares `setuptools>=16.0`, so pip installs the newest one.
# setuptools 82.0.0 removed `pkg_resources`, which that same module imports
# at line 4 of its dependencies.py, so an unconstrained resolve builds an
# image whose `semgrep --version` dies with ModuleNotFoundError. Verified by
# bisecting real installs: pkg_resources is present in 81.0.0 and gone in
# 82.0.0.
#
# Pinned below 81 rather than below 82 because 81 still *has*
# pkg_resources but warns on every import, so a working image would print a
# deprecation notice on every semgrep invocation. Drop this pin once semgrep
# ships an opentelemetry that no longer imports pkg_resources.
#
# The floor (#239's transitive-dependency scan job found this) matters just
# as much as the ceiling: nothing pinned a minimum, so an unconstrained
# resolve was free to land anywhere below 81 -- observed landing on 70.3.0,
# which carries CVE-2025-47273 (HIGH, path traversal in PackageIndex).
# 78.1.1 is the real fix version and stays comfortably under the
# pkg_resources ceiling, so both constraints hold at once.
#
# One setuptools issue in the same scan, CVE-2026-59890 (MEDIUM, MANIFEST.in
# exclusion bypass via Unicode normalization), needs >=83.0.0 -- above the
# pkg_resources ceiling, so it stays open until that ceiling can be lifted.
# Not worked around here: forcing it past 81 would silently break semgrep,
# which is a worse outcome than one open MEDIUM with a documented reason.
# Tracked, alongside a HIGH in protobuf blocked the same way, in #265.
COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install -r requirements.txt semgrep "setuptools>=78.1.1,<81" \
    && semgrep --version

COPY . .

# --- Runtime: distroless, no shell, no package manager ----------------------
FROM gcr.io/distroless/cc-debian12 AS runtime

# Python interpreter + its shared library (python:3.12-slim installs both
# under /usr/local -- not part of the OS package manager, so nothing here
# depends on apt/dpkg being present at runtime).
COPY --from=builder /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=builder /usr/local/lib/libpython3.12.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12

# Native scanner binaries -- Gitleaks/Trivy/gosec confirmed static (no .so
# deps) via ldd. `semgrep` itself is pip's generated console-script (a
# `#!/usr/local/bin/python3.12` shebang wrapper around the semgrep package
# already under site-packages) -- easy to miss since runner.py invokes it by
# bare name like the other three, but it isn't a native binary like them.
COPY --from=builder /usr/local/bin/gitleaks /usr/local/bin/gitleaks
COPY --from=builder /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=builder /usr/local/bin/gosec /usr/local/bin/gosec
# `semgrep`'s native CLI binary shells out to a second pip console-script,
# `pysemgrep`, by bare name via PATH for most real functionality -- missing
# it fails with "execvp pysemgrep: No such file or directory" despite
# `semgrep --version` on its own looking like it might work.
COPY --from=builder /usr/local/bin/semgrep /usr/local/bin/semgrep
COPY --from=builder /usr/local/bin/pysemgrep /usr/local/bin/pysemgrep

# git + git-remote-https + the ~28 shared libraries the https helper's
# libcurl-gnutls stack pulls in transitively (TLS/crypto, HTTP/2, SSH,
# GSSAPI/LDAP/SASL, brotli, IDN) -- see the note above `builder` for why
# this is much larger than a plain `ldd git` would suggest.
COPY --from=builder /usr/bin/git /usr/bin/git
COPY --from=builder /usr/lib/git-core /usr/lib/git-core
COPY --from=builder \
    /usr/lib/x86_64-linux-gnu/libz.so.1 \
    /usr/lib/x86_64-linux-gnu/libzstd.so.1 \
    /usr/lib/x86_64-linux-gnu/libpcre2-8.so.0 \
    /usr/lib/x86_64-linux-gnu/libcom_err.so.2 \
    /usr/lib/x86_64-linux-gnu/libgssapi_krb5.so.2 \
    /usr/lib/x86_64-linux-gnu/libk5crypto.so.3 \
    /usr/lib/x86_64-linux-gnu/libkeyutils.so.1 \
    /usr/lib/x86_64-linux-gnu/libkrb5.so.3 \
    /usr/lib/x86_64-linux-gnu/libkrb5support.so.0 \
    /usr/lib/x86_64-linux-gnu/liblber-2.5.so.0 \
    /usr/lib/x86_64-linux-gnu/libldap-2.5.so.0 \
    /usr/lib/x86_64-linux-gnu/libsasl2.so.2 \
    /usr/lib/x86_64-linux-gnu/libselinux.so.1 \
    /usr/lib/x86_64-linux-gnu/libcurl-gnutls.so.4 \
    /usr/lib/x86_64-linux-gnu/libnghttp2.so.14 \
    /usr/lib/x86_64-linux-gnu/libidn2.so.0 \
    /usr/lib/x86_64-linux-gnu/librtmp.so.1 \
    /usr/lib/x86_64-linux-gnu/libssh2.so.1 \
    /usr/lib/x86_64-linux-gnu/libpsl.so.5 \
    /usr/lib/x86_64-linux-gnu/libnettle.so.8 \
    /usr/lib/x86_64-linux-gnu/libgnutls.so.30 \
    /usr/lib/x86_64-linux-gnu/libhogweed.so.6 \
    /usr/lib/x86_64-linux-gnu/libgmp.so.10 \
    /usr/lib/x86_64-linux-gnu/libp11-kit.so.0 \
    /usr/lib/x86_64-linux-gnu/libtasn1.so.6 \
    /usr/lib/x86_64-linux-gnu/libunistring.so.2 \
    /usr/lib/x86_64-linux-gnu/libffi.so.8 \
    /usr/lib/x86_64-linux-gnu/libbrotlidec.so.1 \
    /usr/lib/x86_64-linux-gnu/libbrotlicommon.so.1 \
    /usr/lib/x86_64-linux-gnu/

# App code.
WORKDIR /app
COPY --from=builder /app /app

ENV PATH="/usr/local/bin:$PATH" \
    LD_LIBRARY_PATH="/usr/local/lib" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# No shell to interpret an entrypoint script or a shebang line -- invoke the
# copied interpreter directly as a module, exec-form only (already is).
CMD ["python3.12", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
