# Env vars for `docker compose up` (see README.md's "Docker Compose" section).
#
# Copy this file to .env in the repo root, then fill in real values as
# needed:
#
#   cp .env.example .env
#
# Every value below has a safe local-dev default baked into docker-compose.yml
# itself, so `docker compose up --build` works with zero setup. Override
# anything here (or leave .env absent entirely) to change it -- .env is
# git-ignored, so it's safe to put real secrets in your local copy.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=osp
POSTGRES_PASSWORD=osp
POSTGRES_DB=osp

# --- Backend / Celery worker (backend/app/core/config.py) ----------------
# A GitHub personal access token used to clone private repos for native scans
# (alternative: a git credential helper already configured on the host, not
# applicable inside containers). Leave blank for public repos only.
GITHUB_TOKEN=

# Shared secret CI pipelines send as a header to push scan results via the
# ingest API (see backend/app/api/ingest.py). Change this before exposing the
# backend beyond localhost.
WORKSPACE_API_KEY=dev-local-key

# HMAC key used to sign the session cookie. Change this before any
# non-local/non-throwaway use.
SESSION_SECRET=dev-local-session-secret-change-me

# Set to True only once the stack is served over HTTPS (e.g. behind a real
# reverse proxy/TLS terminator) -- must stay False for plain http://
# localhost use, otherwise the browser will silently refuse to send the
# session cookie back and every request will look logged-out.
COOKIE_SECURE=False

# Seeded admin account, created on first backend startup if it doesn't
# already exist. Change ADMIN_PASSWORD before any non-local use.
ADMIN_EMAIL=admin@rikugan.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# Enables the AI-assisted finding analysis feature (app/api/ai.py). Leave
# blank to disable -- the rest of the platform works fine without it.
ANTHROPIC_API_KEY=

# Fernet key (urlsafe-base64, 32 bytes) used to encrypt secrets at rest
# (GitHub App private key/client secret/webhook secret). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SET THIS. If left blank, a fresh ephemeral key is minted on every process
# start, which permanently orphans every previously-encrypted row (GitHub App
# private key, client secret, webhook secret, Slack/Jira/SIEM webhooks) on
# each restart -- and a multi-worker deployment has each worker mint a
# *different* one, so a secret written by one cannot be read by another.
# Blank is survivable only for a throwaway local run you never restart.
PLATFORM_ENCRYPTION_KEY=

# --- Public addresses ------------------------------------------------------
# Where other people and other machines reach this deployment. These replace
# what used to be five hardcoded "localhost" literals in the backend, and
# they are what decides whether Rikugan can leave one laptop:
#
#   PUBLIC_BASE_URL  the frontend, as a browser reaches it. Used for every
#                    link Rikugan posts to GitHub (PR comment "review in
#                    Rikugan", the commit status target_url) and as the
#                    allowed CORS origin. If this is wrong, teammates get
#                    dead links and the login form fails CORS.
#   PUBLIC_API_URL   this backend, as GitHub's servers reach it. Used for the
#                    GitHub App manifest's callback/webhook URLs. GitHub
#                    cannot resolve "localhost" -- a localhost value here
#                    produces an App that can never call back.
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Additional browser origins allowed to call the API, comma-separated.
# PUBLIC_BASE_URL is always allowed and does not need repeating here.
EXTRA_CORS_ORIGINS=

# --- Frontend --------------------------------------------------------------
# Build-time only: baked into the browser bundle by `next build`, so it must
# be an address your browser (on the host) can reach -- the backend's
# published port below by default. Changing this requires rebuilding the
# frontend image (`docker compose up --build frontend`).
NEXT_PUBLIC_API_URL=http://localhost:8000
