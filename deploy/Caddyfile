# Reverse proxy for the two subdomains, TLS terminated with a Cloudflare
# Origin CA certificate (deploy/README.md explains how to generate one) --
# this avoids Let's Encrypt's HTTP-01 challenge, which can't reach an origin
# hidden behind Cloudflare's proxy (the orange-cloud DNS records).
#
# Set Cloudflare's SSL/TLS mode to "Full (strict)" so the edge validates
# this certificate rather than accepting anything.

toleman.oasisgoods.store {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	reverse_proxy frontend:3000
}

api.toleman.oasisgoods.store {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	reverse_proxy backend:8000
}
