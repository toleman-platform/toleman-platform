DATABASE_URL=postgresql+psycopg://osp:osp@localhost:5432/osp
REDIS_URL=redis://localhost:6379/0
# GitHub credentials are no longer taken from the environment. Configure a
# per-workspace GitHub token in the UI (Admin -> Integrations -> GitHub
# Token), stored encrypted with optional auto-expiry. Public repos need none.
WORKSPACE_API_KEY=dev-local-key
SCAN_WORKDIR=/tmp/toleman-scans
SESSION_SECRET=dev-local-session-secret-change-me
# Set to True in production/HTTPS deployments so the session cookie is only
# ever sent over TLS. Must stay False for local http:// dev.
COOKIE_SECURE=False
ADMIN_EMAIL=admin@toleman.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin
ANTHROPIC_API_KEY=
# Fernet key used to encrypt secrets at rest (GitHub App private key/client
# secret/webhook secret). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production - if unset, an ephemeral key is generated per process
# at startup and a warning is logged, but any previously-encrypted rows become
# undecryptable on restart.
PLATFORM_ENCRYPTION_KEY=
